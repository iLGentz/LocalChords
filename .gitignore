# Ambiente Python e uv
.venv/
.uv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Dati e log creati in esecuzione
data/
logs/

# Strumenti scaricati da setup.ps1 (FFmpeg portabile)
tools/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Segreti e configurazione locale
.env
.claude/settings.local.json

# graphify: si pubblicano solo grafo, report e verifica (non cache, manifest e file interni
# che contengono percorsi locali)
graphify-out/*
!graphify-out/graph.html
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
graphify-codice/graphify-out/*
!graphify-codice/graphify-out/graph.html
!graphify-codice/graphify-out/graph.json
!graphify-codice/graphify-out/graph_grezzo.json
!graphify-codice/graphify-out/verifica_filtro.json