# LocalChords — configurazione. Copia questo file in `.env` (setup.ps1 lo fa da solo).
# Nessun segreto è richiesto: l'app non usa account né chiavi API.
# I percorsi relativi sono rispetto alla cartella dell'app.

# --- Cartelle -------------------------------------------------------------------------
# Database SQLite, audio, stem, waveform, cache e modelli scaricati.
LOCALCHORDS_DATA_DIR=data
# Log JSON (app.log, worker.log).
LOCALCHORDS_LOGS_DIR=logs
# Interfaccia compilata (npm run build).
LOCALCHORDS_FRONTEND_DIST=frontend/dist

# --- Server interno ---------------------------------------------------------------------
# Ascolta solo in locale. Se la porta è occupata, l'app ne sceglie una libera.
LOCALCHORDS_HOST=127.0.0.1
LOCALCHORDS_PORT=8765
# DEBUG, INFO, WARNING, ERROR
LOCALCHORDS_LOG_LEVEL=INFO

# --- Hardware ---------------------------------------------------------------------------
# Runtime installato da setup.ps1: cpu | nvidia (non modificare a mano: riesegui setup.ps1).
LOCALCHORDS_INSTALLED_RUNTIME=cpu
# Dispositivo per l'elaborazione: auto | nvidia | cpu (modificabile anche dalle impostazioni).
LOCALCHORDS_DEVICE=auto
# Thread CPU massimi per l'elaborazione (0 = automatico).
LOCALCHORDS_CPU_THREADS=0

# --- Import ---------------------------------------------------------------------------
# Dimensione massima di un file audio caricato, in MB.
LOCALCHORDS_MAX_UPLOAD_MB=500
# Adapter YouTube (yt-dlp): disattivato di default.
LOCALCHORDS_YOUTUBE_ENABLED=false
# Ricerca dei testi su LRCLIB (unica chiamata esterna, facoltativa).
LOCALCHORDS_LRCLIB_ENABLED=true

# --- Strumenti esterni -------------------------------------------------------------------
# Percorso di ffmpeg.exe. Vuoto = tools\ffmpeg\bin\ffmpeg.exe, poi il PATH.
LOCALCHORDS_FFMPEG_PATH=

# --- Worker -----------------------------------------------------------------------------
# Intervallo di controllo della coda e dell'heartbeat, in secondi.
LOCALCHORDS_WORKER_POLL_INTERVAL_S=1.0
LOCALCHORDS_WORKER_HEARTBEAT_INTERVAL_S=5.0
# Dopo quanti secondi senza heartbeat un worker è considerato morto.
LOCALCHORDS_WORKER_STALE_AFTER_S=30.0
# Tentativi massimi per un job interrotto da un crash prima di segnarlo come fallito.
LOCALCHORDS_JOB_MAX_ATTEMPTS=3
